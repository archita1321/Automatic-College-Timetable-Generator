@model IEnumerable<AutomaticCollegeTimetableGenerator.Models.SubstituteTeacher>

@{
    ViewData["Title"] = "Substitute Teacher Allocation";
}

<div class="container mt-4">

    <a asp-controller="Home"
       asp-action="Dashboard"
       class="btn btn-outline-primary mb-3">
        ← Back to Dashboard
    </a>

    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">
            🔄 Substitute Teacher Allocation
        </h2>

        <p class="text-muted">
            Manage substitute teacher assignments
        </p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    <a asp-action="Create"
       class="btn btn-success rounded-pill mb-3">
        ➕ Assign Substitute
    </a>

    <div class="table-responsive">

        <table class="table table-bordered table-hover text-center align-middle">

            <thead class="table-primary">
                <tr>
                    <th>Absent Teacher</th>
                    <th>Substitute Teacher</th>
                    <th>Day</th>
                    <th>Time</th>
                    <th>Subject</th>
                    <th>Class</th>
                    <th>Status</th>
                    <th>Action</th>
                </tr>
            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.AbsentTeacher
                            </td>

                            <td>
                                @item.SubstituteTeacherName
                            </td>

                            <td>
                                @item.Day
                            </td>

                            <td>
                                @item.TimeSlot
                            </td>

                            <td>
                                @item.Subject
                            </td>

                            <td>
                                @item.ClassName
                            </td>

                            <td>
                                <span class="badge bg-success">
                                    @item.Status
                                </span>
                            </td>

                            <td>

                                <a asp-action="Edit"
                                   asp-route-id="@item.Id"
                                   class="btn btn-warning btn-sm mb-1">
                                    ✏️ Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@item.Id"
                                      method="post"
                                      style="display:inline;">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger btn-sm"
                                            onclick="return confirm('Delete this substitution?');">
                                        🗑️ Delete
                                    </button>

                                </form>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8"
                            class="text-danger">
                            No Substitute Assigned
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>