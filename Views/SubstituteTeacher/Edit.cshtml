@model AutomaticCollegeTimetableGenerator.Models.SubstituteTeacher

@{
    ViewData["Title"] = "Edit Substitute Teacher";
}

<div class="container mt-4">

    <a asp-action="Index"
       class="btn btn-outline-primary mb-3">
        ← Back to Substitute List
    </a>

    <div class="text-center mb-4">
        <h2 class="fw-bold text-primary">
            ✏️ Edit Substitute Teacher
        </h2>

        <p class="text-muted">
            Update substitute teacher assignment
        </p>
    </div>

    <div class="card shadow rounded-4">

        <div class="card-body p-4">

            <form asp-action="Edit" method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <!-- Absent Teacher -->

                <div class="mb-3">
                    <label class="fw-bold">
                        Absent Teacher
                    </label>

                    <select asp-for="AbsentTeacher"
                            class="form-select"
                            required>

                        <option value="">
                            -- Select Absent Teacher --
                        </option>

                        @foreach (var teacher in ViewBag.Teachers)
                        {
                            <option value="@teacher.TeacherName">
                                @teacher.TeacherName
                            </option>
                        }

                    </select>
                </div>


                <!-- Substitute Teacher -->

                <div class="mb-3">
                    <label class="fw-bold">
                        Substitute Teacher
                    </label>

                    <select asp-for="SubstituteTeacherName"
                            class="form-select"
                            required>

                        <option value="@Model.SubstituteTeacherName">
                            @Model.SubstituteTeacherName
                        </option>

                    </select>
                </div>


                <!-- Day -->

                <div class="mb-3">
                    <label class="fw-bold">
                        Day
                    </label>

                    <select asp-for="Day"
                            class="form-select"
                            required>

                        <option value="Monday">Monday</option>
                        <option value="Tuesday">Tuesday</option>
                        <option value="Wednesday">Wednesday</option>
                        <option value="Thursday">Thursday</option>
                        <option value="Friday">Friday</option>
                        <option value="Saturday">Saturday</option>

                    </select>
                </div>


                <!-- Time -->

                <div class="mb-3">
                    <label class="fw-bold">
                        Time
                    </label>

                    <input asp-for="TimeSlot"
                           class="form-control"
                           required />
                </div>


                <!-- Subject -->

                <div class="mb-3">
                    <label class="fw-bold">
                        Subject
                    </label>

                    <input asp-for="Subject"
                           class="form-control"
                           required />
                </div>


                <!-- Class -->

                <div class="mb-3">
                    <label class="fw-bold">
                        Class
                    </label>

                    <input asp-for="ClassName"
                           class="form-control"
                           required />
                </div>


                <input type="hidden"
                       asp-for="Status"
                       value="Assigned" />


                <button type="submit"
                        class="btn btn-success rounded-pill px-4">
                    💾 Save Changes
                </button>

                <a asp-action="Index"
                   class="btn btn-secondary rounded-pill px-4 ms-2">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>