@* Views/Shared/_Layout.cshtml *@

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Automatic College Timetable Generator</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>


<body>

    <header>

        <nav class="navbar navbar-expand-lg navbar-dark shadow-lg custom-navbar">

            <div class="container">

                <a class="navbar-brand fw-bold fs-5"
                   asp-controller="Home"
                   asp-action="Index">

                    <i class="bi bi-calendar-check"></i>
                    Automatic College Timetable Generator

                </a>


                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#navbarMenu">

                    <span class="navbar-toggler-icon"></span>

                </button>


                <div class="collapse navbar-collapse" id="navbarMenu">

                    <ul class="navbar-nav ms-auto">


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Index">

                                <i class="bi bi-house"></i>
                                Home

                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Dashboard">

                                <i class="bi bi-speedometer2"></i>
                                Dashboard

                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Timetable"
                               asp-action="Create">

                                <i class="bi bi-calendar-plus"></i>
                                Generate

                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="About">

                                <i class="bi bi-info-circle"></i>
                                About

                            </a>
                        </li>


                        <li class="nav-item">
                            <a class="nav-link"
                               asp-controller="Home"
                               asp-action="Logout">

                                <i class="bi bi-box-arrow-right"></i>
                                Logout

                            </a>
                        </li>


                    </ul>

                </div>

            </div>

        </nav>

    </header>



    <main class="container mt-4">

        @RenderBody()

    </main>



    <footer class="text-center mt-5 py-3 shadow-lg footer">

        <!-- Footer Menu -->
        <div class="mb-2">

            <a asp-controller="Home"
               asp-action="Index"
               class="text-white text-decoration-none mx-2">
                🏠 Home
            </a>

            <a asp-controller="Home"
               asp-action="Dashboard"
               class="text-white text-decoration-none mx-2">
                📊 Dashboard
            </a>

            <a asp-controller="Timetable"
               asp-action="Create"
               class="text-white text-decoration-none mx-2">
                📅 Generate
            </a>

            <a asp-controller="Home"
               asp-action="About"
               class="text-white text-decoration-none mx-2">
                ℹ️ About
            </a>

        </div>

        <h6 class="mb-1">
            <i class="bi bi-calendar-check"></i>
            Automatic College Timetable Generator
        </h6>

        <p class="mb-0">
            © 2026 | Developed by Archita More
        </p>

    </footer>



    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js"></script>


    @await RenderSectionAsync("Scripts", required: false)


</body>

</html>