@model AutomaticCollegeTimetableGenerator.Models.SemesterSelectionViewModel

@{
    ViewData["Title"] = "Select Semester";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0 rounded-4 mx-auto"
         style="max-width: 600px;">

        <div class="card-body p-5 text-center">

            <h2 class="fw-bold text-primary mb-3">
                🎓 Select Semester
            </h2>

            <p class="text-muted mb-4">
                Please select your semester to view your timetable.
            </p>

            <form asp-controller="ClassLogin"
                  asp-action="SelectSemester"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="mb-4 text-start">

                    <label asp-for="Semester"
                           class="form-label fw-bold">
                        Select Semester
                    </label>

                    <select asp-for="Semester"
                            class="form-select">

                        <option value="">-- Select Semester --</option>

                        <option value="1">Semester 1</option>
                        <option value="2">Semester 2</option>
                        <option value="3">Semester 3</option>
                        <option value="4">Semester 4</option>
                        <option value="5">Semester 5</option>
                        <option value="6">Semester 6</option>

                    </select>

                    <span asp-validation-for="Semester"
                          class="text-danger">
                    </span>

                </div>

                <button type="submit"
                        class="btn btn-primary rounded-pill px-5">
                    Continue →
                </button>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}