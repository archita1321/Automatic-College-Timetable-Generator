@model AutomaticCollegeTimetableGenerator.Models.Class

@{
    ViewData["Title"] = "Delete Class";
}

<div class="container mt-4">

    <h2 class="text-danger">Delete Class</h2>
    <hr />

    <h5>Are you sure you want to delete this class?</h5>

    <div>
        <p><strong>Class Name:</strong> @Model.ClassName</p>
        <p><strong>Department:</strong> @Model.Department</p>
        <p><strong>Semester:</strong> @Model.Semester</p>
    </div>

    <form asp-action="Delete" method="post">

        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>

    </form>

</div>