@{
    ViewData["Title"] = "Home";
}

<style>
    .department-card,
    .feature-card {
        transition: transform 0.2s ease;
    }

        .department-card:hover {
            transform: translateY(-5px);
        }

        .department-card h1,
        .feature-card h1 {
            font-size: 32px;
            margin-bottom: 8px !important;
        }

        .department-card h5,
        .feature-card h5 {
            font-size: 18px;
        }

        .department-card p,
        .feature-card p {
            font-size: 14px;
            margin-bottom: 0;
        }
</style>


<div class="container mt-2">

    <!-- ================= HERO SECTION ================= -->
    <!-- ================= HERO SECTION ================= -->
    <!-- ================= HERO SECTION ================= -->

    <div class="text-center">

        <div class="p-3 mb-3 rounded-4 shadow-lg"
             style="background:linear-gradient(135deg,#0f2027,#203a43,#2c5364); color:white;">

            <!-- COLLEGE LOGO + NAME -->

            <div class="d-flex align-items-center justify-content-center gap-3">

                <img src="~/images/college-logo.png.jpeg"
                     alt="College Logo"
                     style="width:85px; height:85px; object-fit:contain;">

                <h2 class="fw-bold mb-0"
                    style="font-size:32px; letter-spacing:0.5px;">
                    DNYANDEEP COLLEGE OF SCIENCE AND COMMERCE
                </h2>

            </div>

            <!-- PROJECT NAME CENTER -->

            <h4 class="fw-semibold text-center mt-3 mb-2"
                style="font-size:22px;">
                Automatic College Timetable Generator
            </h4>

            <p class="lead mb-4">
                Smart, Fast & Automated Timetable Management System
            </p>

            <div class="d-flex justify-content-center gap-3">

                <a asp-controller="Home"
                   asp-action="Login"
                   class="btn btn-warning btn-lg px-5 fw-bold">
                    Admin Login →
                </a>

                <a asp-controller="Student"
                   asp-action="Login"
                   class="btn btn-success btn-lg px-5 fw-bold">
                    🎓 Student Login →
                </a>

            </div>

        </div>

    </div>

    <!-- ================= DEPARTMENTS ================= -->

    <div class="row g-2">

        <!-- COMPUTER SCIENCE -->
        <div class="col-md-3">

            <a asp-controller="Department"
               asp-action="ComputerScience"
               class="text-decoration-none">

                <div class="card department-card h-100 shadow-lg border-0 rounded-4 text-center p-3 text-white"
                     style="background:linear-gradient(135deg,#0d6efd,#4f8cff);">

                    <div class="card-body">

                        <h1>💻</h1>

                        <h5 class="fw-bold">
                            Computer Science
                        </h5>

                        <p class="text-white">
                            B.Sc. Computer Science Department
                        </p>

                    </div>

                </div>

            </a>

        </div>


        <!-- INFORMATION TECHNOLOGY -->
        <div class="col-md-3">

            <a asp-controller="Department"
               asp-action="InformationTechnology"
               class="text-decoration-none">

                <div class="card department-card h-100 shadow-lg border-0 rounded-4 text-center p-3 text-white"
                     style="background:linear-gradient(135deg,#198754,#20c997);">

                    <div class="card-body">

                        <h1>🖥️</h1>

                        <h5 class="fw-bold">
                            Information Technology
                        </h5>

                        <p class="text-white">
                            B.Sc. Information Technology Department
                        </p>

                    </div>

                </div>

            </a>

        </div>


        <!-- COMMERCE -->
        <div class="col-md-3">

            <a asp-controller="Department"
               asp-action="Commerce"
               class="text-decoration-none">

                <div class="card department-card h-100 shadow-lg border-0 rounded-4 text-center p-3 text-white"
                     style="background:linear-gradient(135deg,#fd7e14,#ffc107);">

                    <div class="card-body">

                        <h1>📚</h1>

                        <h5 class="fw-bold">
                            Commerce
                        </h5>

                        <p class="text-white">
                            Bachelor of Commerce Department
                        </p>

                    </div>

                </div>

            </a>

        </div>


        <!-- HOTEL MANAGEMENT -->
        <div class="col-md-3">

            <a asp-controller="Department"
               asp-action="HotelManagement"
               class="text-decoration-none">

                <div class="card department-card h-100 shadow-lg border-0 rounded-4 text-center p-3 text-white"
                     style="background:linear-gradient(135deg,#e83e8c,#ff6b9d);">

                    <div class="card-body">

                        <h1>🏨</h1>

                        <h5 class="fw-bold">
                            Hotel Management
                        </h5>

                        <p class="text-white">
                            Hotel Management Department
                        </p>

                    </div>

                </div>

            </a>

        </div>

    </div>


    <!-- ================= FEATURES ================= -->

    <div class="mt-3">

        <h4 class="text-center fw-bold mb-2">
            ⭐ Why Choose Our System?
        </h4>


        <div class="row g-3">

            <!-- FAST GENERATION -->
            <div class="col-md-4">

                <div class="card feature-card h-100 border-0 shadow-lg rounded-4 text-center p-2 text-white"
                     style="background:linear-gradient(135deg,#6610f2,#6f42c1);">

                    <h1>⚡</h1>

                    <h5 class="fw-bold">
                        Fast Generation
                    </h5>

                    <p>
                        Create timetables within seconds.
                    </p>

                </div>

            </div>


            <!-- CLASH DETECTION -->
            <div class="col-md-4">

                <div class="card feature-card h-100 border-0 shadow-lg rounded-4 text-center p-2 text-white"
                     style="background:linear-gradient(135deg,#198754,#20c997);">

                    <h1>🛡️</h1>

                    <h5 class="fw-bold">
                        Clash Detection
                    </h5>

                    <p>
                        Avoid teacher and classroom conflicts.
                    </p>

                </div>

            </div>


            <!-- EASY MANAGEMENT -->
            <div class="col-md-4">

                <div class="card feature-card h-100 border-0 shadow-lg rounded-4 text-center p-2 text-white"
                     style="background:linear-gradient(135deg,#fd7e14,#dc3545);">

                    <h1>📊</h1>

                    <h5 class="fw-bold">
                        Easy Management
                    </h5>

                    <p>
                        Manage teachers, subjects and classrooms easily.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>