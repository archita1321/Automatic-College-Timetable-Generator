@model IEnumerable<AutomaticCollegeTimetableGenerator.Models.Timetable>

@{
    ViewData["Title"] = "Teacher Timetable";
}

<div class="container mt-4">

    <div class="mb-3">
        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-outline-primary">
            ← Back to Dashboard
        </a>
    </div>

    <div class="text-center mb-4">

        <h2 class="fw-bold text-primary">
            👨‍🏫 Teacher Timetable
        </h2>

        <h4 class="text-secondary">
            DNYANDEEP COLLEGE OF SCIENCE AND COMMERCE
        </h4>

        <p class="text-muted">
            Khed, Ratnagiri, Maharashtra
        </p>

        <p>
            <b>Academic Year:</b> 2026-27
        </p>

    </div>

    <!-- TEACHER SELECTION -->

    <form method="get"
          asp-controller="Timetable"
          asp-action="TeacherTimetable">

        <div class="row mb-4">

            <div class="col-md-5">

                <label class="form-label fw-bold">
                    Select Teacher
                </label>

                <select name="teacherName"
                        class="form-select">

                    <option value="">
                        Select Teacher
                    </option>

                    @foreach (var teacher in ViewBag.Teachers)
                    {
                        <option value="@teacher"
                                selected="@(ViewBag.TeacherName == teacher)">
                            @teacher
                        </option>
                    }

                </select>

            </div>

            <div class="col-md-2 d-flex align-items-end">

                <button type="submit"
                        class="btn btn-primary">
                    View Timetable
                </button>

            </div>

        </div>

    </form>

    @if (!string.IsNullOrWhiteSpace(ViewBag.TeacherName))
    {
        <div class="alert alert-info">
            👨‍🏫 <b>Teacher:</b> @ViewBag.TeacherName
            <br />
            📚 <b>Total Scheduled Periods:</b> @Model.Count()
        </div>
    }


    <!-- TEACHER TIMETABLE -->

    <div class="table-responsive">

        <table class="table table-bordered text-center align-middle">

            <thead class="table-primary">

                <tr>
                    <th>Time</th>
                    <th>Monday</th>
                    <th>Tuesday</th>
                    <th>Wednesday</th>
                    <th>Thursday</th>
                    <th>Friday</th>
                    <th>Saturday</th>
                </tr>

            </thead>

            <tbody>

                @foreach (var time in new[]
                {
                    "9:00 AM - 10:00 AM",
                    "10:00 AM - 11:00 AM",
                    "11:30 AM - 12:30 PM",
                    "12:30 PM - 1:30 PM"
                })
                {
                    <tr>

                        <td class="fw-bold">
                            @time
                        </td>

                        @foreach (var day in new[]
                        {
                            "Monday",
                            "Tuesday",
                            "Wednesday",
                            "Thursday",
                            "Friday",
                            "Saturday"
                        })
                        {
                            <td>

                                @{
                                    var lectures = Model
                                        .Where(x =>
                                            x.Day == day &&
                                            x.TimeSlot == time)
                                        .ToList();
                                }

                                @if (lectures.Any())
                                {
                                    foreach (var lecture in lectures)
                                    {
                                        <div class="lecture-card mb-1">

                                            <b>
                                                @lecture.Subject
                                            </b>

                                            <br />

                                            <span>
                                                🏫 @lecture.ClassName
                                            </span>

                                            <br />

                                            <small>
                                                🚪 Room: @lecture.Classroom
                                            </small>

                                        </div>
                                    }
                                }
                                else
                                {
                                    <span class="text-muted">—</span>
                                }

                            </td>
                        }

                    </tr>
                }

            </tbody>

        </table>

    </div>


    <!-- SUBJECT LIST -->
    @if (!string.IsNullOrWhiteSpace(ViewBag.TeacherName))
    {
        <div class="card shadow-sm mt-4">

            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">
                    📚 Subjects Scheduled for
                    @ViewBag.TeacherName
                </h5>
            </div>

            <div class="card-body">

                @if (Model.Any())
                {
                    <div class="row">

                        @foreach (var subject in Model
                            .Where(x => !string.IsNullOrWhiteSpace(x.Subject))
                            .GroupBy(x => x.Subject)
                            .Select(g => new
                            {
                                Subject = g.Key,
                                Classes = string.Join(
                                    ", ",
                                    g.Select(x => x.ClassName)
                                     .Where(x => !string.IsNullOrWhiteSpace(x))
                                     .Distinct())
                            }))
                        {
                            <div class="col-md-4 mb-2">

                                <div class="border rounded p-2">

                                    📖 <b>@subject.Subject</b>

                                    <br />

                                    <small class="text-muted">
                                        Class: @subject.Classes
                                    </small>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <div class="alert alert-warning mb-0">
                        No timetable has been generated for this teacher.
                    </div>
                }

            </div>

        </div>
    }


    <!-- PRINT -->

    <div class="mt-3">

        <button onclick="window.print()"
                class="btn btn-success">
            🖨 Print Teacher Timetable
        </button>

    </div>

</div>


<style>

    .lecture-card {
        background: linear-gradient(135deg, #0d6efd, #6f42c1);
        color: white;
        padding: 8px;
        border-radius: 8px;
        font-size: 12px;
        line-height: 1.3;
    }

        .lecture-card b {
            font-size: 13px;
        }

        .lecture-card span,
        .lecture-card small {
            font-size: 11px;
        }

    .table td {
        vertical-align: middle;
        height: 80px;
        padding: 5px;
    }

    .table th {
        padding: 8px;
    }

    @@media print {

        .btn,
        form {
            display: none !important;
        }

        .table {
            font-size: 10px;
        }

            .table td {
                height: 60px;
            }
    }

</style>