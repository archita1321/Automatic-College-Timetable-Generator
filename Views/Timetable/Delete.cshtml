@model AutomaticCollegeTimetableGenerator.Models.Timetable

@{
    ViewData["Title"] = "Delete Timetable";
}

<div class="container mt-5">

    <div class="card shadow-lg border-0">

        <div class="card-header bg-danger text-white">
            <h3>Delete Timetable</h3>
        </div>

        <div class="card-body">

            <h5 class="text-danger">
                Are you sure you want to delete this timetable?
            </h5>

            <hr />

            <dl class="row">

                <dt class="col-sm-3">Class</dt>
                <dd class="col-sm-9">@Model.ClassName</dd>

                <dt class="col-sm-3">Department</dt>
                <dd class="col-sm-9">@Model.Department</dd>

                <dt class="col-sm-3">Semester</dt>
                <dd class="col-sm-9">@Model.Semester</dd>

                <dt class="col-sm-3">Day</dt>
                <dd class="col-sm-9">@Model.Day</dd>

                <dt class="col-sm-3">Time</dt>
                <dd class="col-sm-9">@Model.TimeSlot</dd>

                <dt class="col-sm-3">Subject</dt>
                <dd class="col-sm-9">@Model.Subject</dd>

                <dt class="col-sm-3">Teacher</dt>
                <dd class="col-sm-9">@Model.Teacher</dd>

                <dt class="col-sm-3">Classroom</dt>
                <dd class="col-sm-9">@Model.Classroom</dd>

            </dl>

            <form asp-action="Delete">

                <input type="hidden" asp-for="Id" />

                <button type="submit" class="btn btn-danger">
                    Delete
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>

    </div>

</div>