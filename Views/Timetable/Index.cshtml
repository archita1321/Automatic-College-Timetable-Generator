@model IEnumerable<AutomaticCollegeTimetableGenerator.Models.Timetable>

@{
    ViewData["Title"] = "Generated Timetable";
}

<link rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

<div class="container mt-4">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <strong>Success!</strong> @TempData["Success"]

            <button type="button"
                    class="btn-close"
                    data-bs-dismiss="alert">
            </button>
        </div>
    }
    @if (TempData["FailedSubjects"] != null)
    {
        <div class="alert alert-warning">
            <strong>Subjects not scheduled:</strong>
            <br />
            @TempData["FailedSubjects"]
        </div>
    }

    <div class="card shadow-lg border-0 rounded-4">

        <div class="card-header bg-primary text-white py-3 d-flex justify-content-between align-items-center">

            <h3 class="mb-0">
                <i class="bi bi-calendar-week"></i>
                Generated Timetable
            </h3>

            <a asp-controller="Home"
               asp-action="Dashboard"
               class="btn btn-light">
                <i class="bi bi-arrow-left-circle"></i>
                Dashboard
            </a>

        </div>

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-8 mb-2">

                    <a asp-action="Create" class="btn btn-success">
                        <i class="bi bi-plus-circle"></i> Generate New
                    </a>

                    <a asp-action="WeeklyTimetable" class="btn btn-info">
                        <i class="bi bi-calendar-week"></i> Weekly View
                    </a>

                    <button onclick="window.print()" class="btn btn-primary">
                        <i class="bi bi-printer"></i> Print
                    </button>

                </div>

                <div class="col-md-4">

                    <input type="text"
                           id="searchBox"
                           class="form-control"
                           placeholder="Search Class, Subject, Teacher..." />

                </div>

            </div>

            <div class="table-responsive">

                <table class="table table-bordered table-hover text-center align-middle"
                       id="timetableTable">

                    <thead class="table-primary text-center align-middle">
                        <tr>
                            <th><i class="bi bi-mortarboard-fill"></i> Class</th>
                            <th><i class="bi bi-building"></i> Department</th>
                            <th><i class="bi bi-book"></i> Semester</th>
                            <th><i class="bi bi-calendar-day"></i> Day</th>
                            <th><i class="bi bi-clock"></i> Time</th>
                            <th><i class="bi bi-journal-bookmark-fill"></i> Subject</th>
                            <th><i class="bi bi-person-fill"></i> Teacher</th>
                            <th><i class="bi bi-door-open-fill"></i> Classroom</th>
                            <th><i class="bi bi-gear-fill"></i> Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>@item.ClassName</td>
                                <td>@item.Department</td>
                                <td>@item.Semester</td>
                                <td>@item.Day</td>
                                <td>@item.TimeSlot</td>
                                <td>@item.Subject</td>
                                <td>@item.Teacher</td>
                                <td>@item.Classroom</td>

                                <td>

                                    <a href="@Url.Action("Edit", "Timetable", new { id = item.Id })"
                                       class="btn btn-warning">
                                        <i class="bi bi-pencil-square"></i>
                                    </a>

                                    <form asp-controller="Timetable"
                                          asp-action="Delete"
                                          method="post"
                                          class="d-inline">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="id"
                                               value="@item.Id" />

                                        <button type="submit"
                                                class="btn btn-danger btn-sm"
                                                onclick="return confirm('Are you sure you want to delete this timetable?');">

                                            <i class="bi bi-trash"></i>

                                        </button>

                                    </form>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

<script>

    document.getElementById("searchBox").addEventListener("keyup", function() {

        var value = this.value.toLowerCase();

        var rows = document.querySelectorAll("#timetableTable tbody tr");

        rows.forEach(function(row) {

            row.style.display = row.innerText.toLowerCase().includes(value)
                ? ""
                : "none";

        });

    });

</script>

<style>

    @@media print {

        table {
            width: 100%;
            font-size: 12px;
        }

        th, td {
            padding: 5px;
            text-align: center;
        }
    }

</style>