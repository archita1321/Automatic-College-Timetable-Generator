@model List<AutomaticCollegeTimetableGenerator.Models.Classroom>

@{
    ViewData["Title"] = "Manage Classrooms";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">

        <h2 class="text-primary fw-bold">
            🚪 Manage Classrooms
        </h2>

        <a asp-controller="Home"
           asp-action="Dashboard"
           class="btn btn-secondary">
            ⬅ Back to Dashboard
        </a>

    </div>

    <hr />

    <a asp-controller="Classroom"
       asp-action="Create"
       class="btn btn-success mb-3">
        ➕ Add New Classroom
    </a>

    <table class="table table-bordered table-hover shadow">

        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Room Number</th>
                <th>Capacity</th>
                <th>Room Type</th>
                <th>Department</th>
                <th>Class</th>
                <th width="180">Actions</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var classroom in Model)
            {
                <tr>

                    <td>@classroom.Id</td>
                    <td>@classroom.RoomNumber</td>
                    <td>@classroom.Capacity</td>
                    <td>@classroom.RoomType</td>
                    <td>@classroom.Department</td>
                    <td>@classroom.ClassName</td>

                    <td>

                        <a asp-action="Edit"
                           asp-route-id="@classroom.Id"
                           class="btn btn-warning btn-sm">
                            <i class="bi bi-pencil-square"></i>
                        </a>

                        <a asp-action="Delete"
                           asp-route-id="@classroom.Id"
                           class="btn btn-danger btn-sm"
                           onclick="return confirm('Are you sure you want to delete this classroom?');">
                            <i class="bi bi-trash"></i>
                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>