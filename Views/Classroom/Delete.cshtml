@model AutomaticCollegeTimetableGenerator.Models.Classroom

@{
    ViewData["Title"] = "Delete Classroom";
}

<div class="container mt-4">

    <h2 class="text-danger">Delete Classroom</h2>
    <hr />

    <h4>Are you sure you want to delete this classroom?</h4>

    <dl class="row">
        <dt class="col-sm-3">Room Number</dt>
        <dd class="col-sm-9">@Model.RoomNumber</dd>

        <dt class="col-sm-3">Capacity</dt>
        <dd class="col-sm-9">@Model.Capacity</dd>

        <dt class="col-sm-3">Room Type</dt>
        <dd class="col-sm-9">@Model.RoomType</dd>
    </dl>

    <form asp-action="Delete">
        <input type="hidden" asp-for="Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancel
        </a>
    </form>

</div>