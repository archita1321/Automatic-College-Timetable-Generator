@model AutomaticCollegeTimetableGenerator.Models.Teacher

@{
    ViewData["Title"] = "Add Teacher";
}

<div class="container py-3">

    <!-- PAGE HEADER -->
    <div class="d-flex align-items-center justify-content-between mb-4">

        <a asp-action="Index"
           class="btn btn-outline-primary rounded-pill px-4">
            <i class="bi bi-arrow-left me-1"></i>
            Back to Teachers
        </a>

        <div class="text-center flex-grow-1">
            <h2 class="fw-bold text-primary mb-1">
                👩‍🏫 Add New Teacher
            </h2>

            <p class="text-muted mb-0">
                Add teacher information to the college system
            </p>
        </div>

        <div style="width: 150px;"></div>

    </div>


    <!-- MAIN CARD -->
    <div class="card border-0 shadow-lg rounded-4 overflow-hidden mx-auto"
         style="max-width: 850px;">

        <!-- CARD HEADER -->
        <div class="bg-primary text-white p-4">

            <div class="d-flex align-items-center">

                <div class="bg-white text-primary rounded-circle
                    d-flex align-items-center justify-content-center"
                     style="width:55px;height:55px;font-size:25px;">

                    <i class="bi bi-person-plus-fill"></i>

                </div>

                <div class="ms-3">

                    <h4 class="fw-bold mb-1">
                        Teacher Registration
                    </h4>

                    <small class="opacity-75">
                        Enter the teacher's details below
                    </small>

                </div>

            </div>

        </div>


        <!-- FORM BODY -->
        <div class="card-body p-4">

            <form asp-controller="Teacher"
                  asp-action="Create"
                  method="post">

                @Html.AntiForgeryToken()


                <!-- VALIDATION SUMMARY -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger rounded-3"
                     role="alert">
                </div>


                <!-- ========================= -->
                <!-- PERSONAL INFORMATION -->
                <!-- ========================= -->

                <div class="mb-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="text-primary fs-4">
                            <i class="bi bi-person-badge-fill"></i>
                        </div>

                        <div class="ms-2">

                            <h5 class="fw-bold mb-0">
                                Personal Information
                            </h5>

                            <small class="text-muted">
                                Basic teacher details
                            </small>

                        </div>

                    </div>


                    <div class="row g-4">

                        <!-- TEACHER NAME -->
                        <div class="col-md-6">

                            <label asp-for="TeacherName"
                                   class="form-label fw-semibold">

                                Teacher Name
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-person"></i>
                                </span>

                                <input asp-for="TeacherName"
                                       class="form-control"
                                       placeholder="Enter full name" />

                            </div>

                            <span asp-validation-for="TeacherName"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- DEPARTMENT -->
                        <div class="col-md-6">

                            <label asp-for="Department"
                                   class="form-label fw-semibold">

                                Department
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-building"></i>
                                </span>

                                <select asp-for="Department"
                                        class="form-select">

                                    <option value="">
                                        -- Select Department --
                                    </option>

                                    @foreach (var item in ViewBag.Departments)
                                    {
                                        <option value="@item.DepartmentName">
                                            @item.DepartmentName
                                        </option>
                                    }

                                </select>

                            </div>

                            <span asp-validation-for="Department"
                                  class="text-danger small">
                            </span>

                        </div>

                    </div>

                </div>


                <hr class="my-5" />


                <!-- ========================= -->
                <!-- CONTACT INFORMATION -->
                <!-- ========================= -->

                <div class="mb-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="text-success fs-4">
                            <i class="bi bi-telephone-fill"></i>
                        </div>

                        <div class="ms-2">

                            <h5 class="fw-bold mb-0">
                                Contact Information
                            </h5>

                            <small class="text-muted">
                                Teacher contact details
                            </small>

                        </div>

                    </div>


                    <div class="row g-4">

                        <!-- EMAIL -->
                        <div class="col-md-6">

                            <label asp-for="Email"
                                   class="form-label fw-semibold">

                                Email Address
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-envelope"></i>
                                </span>

                                <input asp-for="Email"
                                       type="email"
                                       class="form-control"
                                       placeholder="example@gmail.com" />

                            </div>

                            <span asp-validation-for="Email"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- PHONE -->
                        <div class="col-md-6">

                            <label asp-for="Phone"
                                   class="form-label fw-semibold">

                                Phone Number
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-phone"></i>
                                </span>

                                <input asp-for="Phone"
                                       type="tel"
                                       class="form-control"
                                       placeholder="10 digit mobile number"
                                       maxlength="10"
                                       inputmode="numeric"
                                       oninput="this.value = this.value.replace(/[^0-9]/g, '')" />

                            </div>

                            <span asp-validation-for="Phone"
                                  class="text-danger small">
                            </span>

                            <small class="text-muted">
                                Enter exactly 10 digits.
                            </small>

                        </div>

                    </div>

                </div>


                <hr class="my-5" />


                <!-- ========================= -->
                <!-- LOGIN INFORMATION -->
                <!-- ========================= -->

                <div class="mb-4">

                    <div class="d-flex align-items-center mb-3">

                        <div class="text-warning fs-4">
                            <i class="bi bi-shield-lock-fill"></i>
                        </div>

                        <div class="ms-2">

                            <h5 class="fw-bold mb-0">
                                Login Information
                            </h5>

                            <small class="text-muted">
                                Account credentials for the teacher
                            </small>

                        </div>

                    </div>


                    <div class="row g-4">

                        <!-- USERNAME -->
                        <div class="col-md-6">

                            <label asp-for="Username"
                                   class="form-label fw-semibold">

                                Username
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-person-circle"></i>
                                </span>

                                <input asp-for="Username"
                                       class="form-control"
                                       placeholder="Create username" />

                            </div>

                            <span asp-validation-for="Username"
                                  class="text-danger small">
                            </span>

                        </div>


                        <!-- PASSWORD -->
                        <div class="col-md-6">

                            <label asp-for="Password"
                                   class="form-label fw-semibold">

                                Password
                                <span class="text-danger">*</span>

                            </label>

                            <div class="input-group">

                                <span class="input-group-text bg-light">
                                    <i class="bi bi-lock"></i>
                                </span>

                                <input asp-for="Password"
                                       type="password"
                                       class="form-control"
                                       placeholder="Enter password (4-8 characters)"
                                       maxlength="8" />

                            </div>

                            <span asp-validation-for="Password"
                                  class="text-danger small">
                            </span>

                            <small class="text-muted">
                                Password must contain 4-8 characters.
                            </small>

                        </div>

                    </div>

                </div>


                <!-- ========================= -->
                <!-- REQUIRED FIELD NOTE -->
                <!-- ========================= -->

                <div class="alert alert-light border rounded-3 mt-4">

                    <small class="text-muted">
                        <span class="text-danger">*</span>
                        Required fields
                    </small>

                </div>


                <!-- ========================= -->
                <!-- BUTTONS -->
                <!-- ========================= -->

                <div class="d-flex justify-content-end gap-2 mt-4">

                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4">

                        <i class="bi bi-x-circle me-1"></i>
                        Cancel

                    </a>

                    <button type="submit"
                            class="btn btn-primary rounded-pill px-5 shadow-sm">

                        <i class="bi bi-person-plus-fill me-1"></i>
                        Save Teacher

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}