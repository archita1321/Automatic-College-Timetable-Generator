@model AutomaticCollegeTimetableGenerator.Models.Teacher

@{
    ViewData["Title"] = "Edit Teacher";
}

<div class="container mt-4 mb-5">

    <!-- Header -->
    <div class="text-center mb-4">

        <h2 class="fw-bold text-primary">
            👩‍🏫 Update Teacher
        </h2>

        <p class="text-muted">
            Update teacher information
        </p>

    </div>

    <!-- Main Card -->
    <div class="card border-0 shadow-lg rounded-4 mx-auto"
         style="max-width: 850px;">

        <div class="card-body p-4">

            <form asp-controller="Teacher"
                  asp-action="Edit"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden" asp-for="Id" />

                <!-- Validation Summary -->
                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>

                <!-- Teacher Information -->
                <h5 class="fw-bold text-primary mb-3">
                    👤 Teacher Information
                </h5>

                <div class="row">

                    <!-- Teacher Name -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="TeacherName"
                               class="form-label fw-bold">
                            Teacher Name
                        </label>

                        <input asp-for="TeacherName"
                               class="form-control"
                               placeholder="Enter teacher name" />

                        <span asp-validation-for="TeacherName"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Department -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Department"
                               class="form-label fw-bold">
                            Department
                        </label>

                        <select asp-for="Department"
                                class="form-select">

                            <option value="">
                                -- Select Department --
                            </option>

                            @foreach (var department in ViewBag.Departments)
                            {
                                <option value="@department.DepartmentName">
                                    @department.DepartmentName
                                </option>
                            }

                        </select>

                        <span asp-validation-for="Department"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- Contact Information -->
                <h5 class="fw-bold text-success mb-3">
                    📞 Contact Information
                </h5>

                <div class="row">

                    <!-- Email -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Email"
                               class="form-label fw-bold">
                            Email
                        </label>

                        <input asp-for="Email"
                               type="email"
                               class="form-control"
                               placeholder="Enter email address" />

                        <span asp-validation-for="Email"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Phone -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Phone"
                               class="form-label fw-bold">
                            Phone Number
                        </label>

                        <input asp-for="Phone"
                               type="text"
                               class="form-control"
                               placeholder="Enter 10 digit phone number"
                               maxlength="10"
                               inputmode="numeric" />

                        <span asp-validation-for="Phone"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr class="my-4" />

                <!-- Login Information -->
                <h5 class="fw-bold text-warning mb-3">
                    🔐 Login Information
                </h5>

                <div class="row">

                    <!-- Username -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Username"
                               class="form-label fw-bold">
                            Username
                        </label>

                        <input asp-for="Username"
                               class="form-control"
                               placeholder="Enter username" />

                        <span asp-validation-for="Username"
                              class="text-danger">
                        </span>

                    </div>

                    <!-- Password -->
                    <div class="col-md-6 mb-3">

                        <label asp-for="Password"
                               class="form-label fw-bold">
                            Password
                        </label>

                        <input asp-for="Password"
                               type="password"
                               class="form-control"
                               placeholder="4-8 characters" />

                        <span asp-validation-for="Password"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <!-- Buttons -->
                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary rounded-pill px-5">
                        💾 Update Teacher
                    </button>

                    <a asp-action="Index"
                       class="btn btn-outline-secondary rounded-pill px-4 ms-2">
                        ← Back
                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}