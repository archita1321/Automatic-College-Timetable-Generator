@model IEnumerable<AutomaticCollegeTimetableGenerator.Models.TimetableHistory>

@{
    ViewData["Title"] = "Timetable History";
}

<div class="container mt-4">


    <a asp-controller="Home"
       asp-action="Dashboard"
       class="btn btn-outline-primary mb-3">

        ← Back to Dashboard

    </a>



    <div class="text-center mb-4">

        <h2 class="fw-bold text-primary">
            📜 Timetable History
        </h2>

        <p class="text-muted">
            Track previous timetable activities
        </p>

    </div>



    <table class="table table-bordered table-hover text-center">


        <thead class="table-primary">

            <tr>

                <th>Class</th>
                <th>Department</th>
                <th>Action</th>
                <th>Date</th>
                <th>Action</th>

            </tr>

        </thead>



        <tbody>


            @if (Model.Any())
            {

                foreach (var item in Model)
                {

                    <tr>

                        <td>
                            @item.ClassName
                        </td>


                        <td>
                            @item.Department
                        </td>


                        <td>
                            @item.Action
                        </td>


                        <td>
                            @item.CreatedDate.ToString("dd-MM-yyyy hh:mm tt")
                        </td>

                    </tr>
                    <td>
                        <form asp-action="Delete"
                              method="post"
                              onsubmit="return confirm('Are you sure you want to delete this history?');">

                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.Id" />

                            <button type="submit"
                                    class="btn btn-danger btn-sm">

                                🗑️ Delete

                            </button>

                        </form>
                    </td>

                }

            }
            else
            {

                <tr>

                    <td colspan="5"
                        class="text-danger">

                        No History Found

                    </td>

                </tr>

            }


        </tbody>


    </table>


</div>