@model AutomaticCollegeTimetableGenerator.Models.TimetableHistory

@{
    ViewData["Title"] = "Add Timetable History";
}

<div class="container mt-4">

    <a asp-action="Index"
       class="btn btn-outline-primary mb-3">

        ← Back to History

    </a>


    <div class="text-center mb-4">

        <h2 class="fw-bold text-primary">
            📜 Add Timetable History
        </h2>

        <p class="text-muted">
            Track timetable changes
        </p>

    </div>


    <div class="card shadow rounded-4">

        <div class="card-body p-4">


            <form asp-action="Create" method="post">


                <div class="mb-3">

                    <label class="fw-bold">
                        Class Name
                    </label>

                    <input asp-for="ClassName"
                           class="form-control"
                           placeholder="Enter class name" />

                </div>



                <div class="mb-3">

                    <label class="fw-bold">
                        Department
                    </label>

                    <input asp-for="Department"
                           class="form-control"
                           placeholder="Enter department" />

                </div>



                <div class="mb-3">

                    <label class="fw-bold">
                        Action
                    </label>

                    <input asp-for="Action"
                           class="form-control"
                           placeholder="Generated / Updated / Deleted" />

                </div>



                <button type="submit"
                        class="btn btn-success rounded-pill">

                    Save History

                </button>


            </form>


        </div>

    </div>

</div>