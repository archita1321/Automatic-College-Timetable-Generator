@model IEnumerable<AutomaticCollegeTimetableGenerator.Models.Subject>

@{
    ViewData["Title"] = "Manage Subjects";
}

<div class="container mt-3 mb-4">

    <!-- ================= HEADER ================= -->

    <div class="text-center mb-3">

        <h3 class="fw-bold text-success mb-1">
            📚 Manage Subjects
        </h3>

        <p class="text-muted small mb-2">
            Manage teacher-wise subject assignments
        </p>
        <div class="d-flex justify-content-center gap-2">

            <a asp-controller="Home"
               asp-action="Dashboard"
               class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                ← Dashboard
            </a>

            <a asp-action="Create"
               class="btn btn-success btn-sm rounded-pill px-3">
                + Add Teacher Subjects
            </a>

            <form asp-action="DeleteAll"
                  method="post"
                  class="d-inline"
                  onsubmit="return confirm('⚠️ Delete ALL subjects and their teacher assignments? Teachers, classes and departments will NOT be deleted.');">

                @Html.AntiForgeryToken()

                <button type="submit"
                        class="btn btn-danger btn-sm rounded-pill px-3">
                    🗑️ Delete All Subjects
                </button>

            </form>

        </div>

    </div>


    <!-- ================= SUCCESS / ERROR ================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success py-2 small text-center">
            ✅ @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger py-2 small text-center">
            ⚠️ @TempData["ErrorMessage"]
        </div>
    }


    @if (!Model.Any())
    {
        <div class="alert alert-info text-center small">
            📚 No subjects added yet.
        </div>
    }
    else
    {
        var teachers = Model
            .Select(x => x.Teacher)
            .Distinct()
            .OrderBy(x => x);

        foreach (var teacherName in teachers)
        {
            var teacherSubjects = Model
                .Where(x => x.Teacher == teacherName)
                .ToList();

            <!-- ================= TEACHER CARD ================= -->

            <div class="card border-0 shadow-sm rounded-3 mb-3">

                <!-- TEACHER HEADER -->

                <div class="card-header bg-primary text-white py-2 px-3">

                    <div class="d-flex justify-content-between align-items-center">

                        <strong class="small">
                            👩‍🏫 @teacherName
                        </strong>

                        <span class="badge bg-light text-primary">
                            @teacherSubjects.Count Subjects
                        </span>

                    </div>

                </div>


                <!-- SUBJECT TABLE -->

                <div class="card-body p-2">

                    <div class="table-responsive">

                        <table class="table table-sm table-bordered align-middle mb-0 small">

                            <thead class="table-light">

                                <tr>

                                    <th class="py-1 px-2">
                                        Subject
                                    </th>

                                    <th class="py-1 px-2">
                                        Class
                                    </th>

                                    <th class="py-1 px-2">
                                        Department
                                    </th>

                                    <th class="py-1 px-2 text-center">
                                        Sem
                                    </th>

                                    <th class="py-1 px-2 text-center">
                                        Lectures
                                    </th>

                                    <th class="py-1 px-2 text-center">
                                        Duration
                                    </th>

                                    <th class="py-1 px-2 text-center">
                                        Action
                                    </th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var subject in teacherSubjects)
                                {
                                    <tr>

                                        <td class="py-1 px-2 fw-semibold">
                                            @subject.SubjectName
                                        </td>

                                        <td class="py-1 px-2">
                                            @subject.ClassName
                                        </td>

                                        <td class="py-1 px-2">
                                            @subject.Department
                                        </td>

                                        <td class="py-1 px-2 text-center">
                                            @subject.Semester
                                        </td>

                                        <td class="py-1 px-2 text-center">
                                            @subject.LectureCount
                                        </td>

                                        <td class="py-1 px-2 text-center">
                                            @subject.Duration
                                        </td>

                                        <td class="py-1 px-2 text-center">

                                            <!-- EDIT -->
                                            <a asp-action="Edit"
                                               asp-route-id="@subject.Id"
                                               class="btn btn-warning btn-sm py-0 px-2">
                                                ✏️
                                            </a>

                                            <!-- DELETE -->
                                            <a asp-action="Delete"
                                               asp-route-id="@subject.Id"
                                               class="btn btn-danger btn-sm py-0 px-2">
                                                🗑️
                                            </a>

                                        </td>

                                    </tr>
                                }

                            </tbody>

                        </table>

                    </div>

                </div>

            </div>
        }
    }

</div>