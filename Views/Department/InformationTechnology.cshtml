@{
    ViewData["Title"] = "Information Technology Department";
}

<div class="container my-4">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <div class="p-4 text-center text-white"
             style="background:linear-gradient(135deg,#198754,#20c997);">

            <h1 class="fw-bold">🖥️ Information Technology Department</h1>

            <p class="mb-0">
               
            </p>

        </div>

        <div class="card-body p-4">

            <h3 class="fw-bold text-success mb-3">
                About the Department
            </h3>

            <p>
                The Information Technology Department was established in
                2009 with the objective of using technology for the development
                of rural areas.
            </p>

            <p>
                The department has completed around 15 years of educational
                service and has been providing students from rural areas with
                opportunities to build careers in the technology field.
            </p>


            <h3 class="fw-bold text-success mt-4">
                Academic Achievements
            </h3>

            <p>
                During the academic year 2023–2024, the Third Year examination
                result was <strong>100%</strong>.
            </p>

            <ul>
                <li>Total students appeared: <strong>9</strong></li>
                <li><strong>6 students</strong> achieved A+ Grade.</li>
                <li><strong>3 students</strong> achieved A Grade.</li>
            </ul>

            <p>
                The top-performing students were:
            </p>

            <ul>
                <li><strong>Sanjana Pandurang Palkar</strong> – First Rank</li>
                <li><strong>Tanaz Rizwan Mullaji</strong> – Second Rank</li>
                <li><strong>Tasneem Tahir Nadkar</strong> – Third Rank</li>
            </ul>


            <h3 class="fw-bold text-success mt-4">
                Certifications
            </h3>

            <p>
                Students successfully completed various online certification
                courses, including NPTEL, MOOC and other online certification
                programs.
            </p>


            <h3 class="fw-bold text-success mt-4">
                Projects and Competitions
            </h3>

            <ul>
                <li>
                    <strong>Omkar Jadhav</strong> secured Third Rank in the
                    GMRT National Level Virtual Science Exhibition 2023–24.
                </li>

                <li>
                    Students participated in the Avishkar Research Convention.
                </li>

                <li>
                    Students secured Second Rank in a college-level science
                    exhibition.
                </li>
            </ul>


            <h3 class="fw-bold text-success mt-4">
                Workshops and Expert Guidance
            </h3>

            <p>
                The department organized workshops and expert guidance
                sessions for students.
            </p>

            <ul>
                <li>Android App Development</li>
                <li>W3-CSS / Mobile-First Web Design</li>
                <li>Technology-related workshops</li>
                <li>Career guidance and expert lectures</li>
            </ul>


            <h3 class="fw-bold text-success mt-4">
                Cultural and Sports Achievements
            </h3>

            <ul>
                <li>Badminton – Third Rank at the divisional level.</li>
                <li>Table Tennis – Third Rank at the divisional level.</li>
                <li>Football – Student selected for the Konkan Division.</li>
                <li>Students participated in Mumbai University Youth Festival activities.</li>
                <li>Students achieved positions in Rangoli and Elocution competitions.</li>
                <li>
                    Varun Parab represented Ratnagiri district at a
                    state-level NSS camp.
                </li>
                <li>
                    Suhani Ambre participated in a district-level Leadership
                    Training Program.
                </li>
            </ul>


            <h3 class="fw-bold text-success mt-4">
                Social Activities
            </h3>

            <p>
                The department participated in social surveys through
                Lifelong Learning and Extension activities and NSS.
                These activities helped students understand rural communities
                and their issues.
            </p>

        </div>

    </div>
    <div class="text-center mt-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary px-4">
            ← Back to Home
        </a>
    </div>

</div>