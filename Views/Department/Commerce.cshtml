@{
    ViewData["Title"] = "Commerce Department";
}

<div class="container my-4">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <div class="p-4 text-center text-white"
             style="background:linear-gradient(135deg,#fd7e14,#ffc107);">

            <h1 class="fw-bold">📚 Commerce Department</h1>

            <p class="mb-0">
                B.Com Department
            </p>

        </div>

        <div class="card-body p-4">

            <h3 class="fw-bold text-warning mb-3">
                About the Department
            </h3>

            <p>
                The college was established in 2009 and the B.Com. programme
                was started from the beginning. From the academic year
                2022–23, the college also started the M.Com. programme
                affiliated with the University of Mumbai.
            </p>

            <p>
                The Commerce Department has focused on career-oriented
                education since its establishment.
            </p>


            <h3 class="fw-bold text-warning mt-4">
                Academic Achievements
            </h3>

            <p>
                During the academic year 2023–24, the B.Com. Semester VI
                examination achieved an excellent result.
            </p>

            <ul>
                <li>
                    <strong>Rameez Qadri</strong> – First Rank
                </li>

                <li>
                    <strong>Iqra Khalpe</strong> – Second Rank
                </li>

                <li>
                    <strong>Hrishikesh Gadale</strong> – Third Rank
                </li>
            </ul>

            <p>
                Students also achieved different grades including
                A+, A, B+, B and C grades.
            </p>


            <h3 class="fw-bold text-warning mt-4">
                Professional Courses and Career Guidance
            </h3>

            <p>
                The department provides guidance for various professional
                courses and career opportunities.
            </p>

            <ul>
                <li>Chartered Accountancy (CA)</li>
                <li>Company Secretary (CS)</li>
                <li>Cost and Management Accounting (CMA)</li>
                <li>Banking</li>
                <li>Insurance</li>
                <li>MPSC</li>
                <li>Stock Market</li>
            </ul>


            <h3 class="fw-bold text-warning mt-4">
                Certifications and Placement
            </h3>

            <p>
                Commerce students have participated in various professional
                certification courses such as NPTEL, MOOC and other
                certificate programs.
            </p>

            <p>
                Through campus recruitment, Commerce students were selected
                for positions such as Junior Sales Executive at ICICI Bank.
            </p>


            <h3 class="fw-bold text-warning mt-4">
                Workshops and Seminars
            </h3>

            <p>
                The department conducts seminars, workshops and expert
                guidance sessions on various career-oriented topics.
            </p>

            <ul>
                <li>Banking</li>
                <li>Insurance</li>
                <li>MPSC</li>
                <li>Stock Market</li>
                <li>National Education Policy 2020</li>
                <li>Career Development</li>
            </ul>


            <h3 class="fw-bold text-warning mt-4">
                Cultural Achievements
            </h3>

            <p>
                Commerce students participated in the Mumbai University
                Youth Festival and achieved prizes at the divisional level.
            </p>

            <ul>
                <li>
                    <strong>Hrishikesh Sanjay Gadale</strong> – Second Rank
                    in Debate.
                </li>

                <li>
                    <strong>Shreyas Jangam</strong> – Second Rank in
                    Classical Instrumental Music.
                </li>
            </ul>


            <h3 class="fw-bold text-warning mt-4">
                Sports Achievements
            </h3>

            <p>
                Commerce students actively participate in various sports
                activities including:
            </p>

            <ul>
                <li>Cricket</li>
                <li>Badminton</li>
                <li>Kabaddi</li>
                <li>Football</li>
            </ul>

            <p>
                The department focuses on the overall development of students
                by combining academic education with professional, cultural
                and sports activities.
            </p>

        </div>

    </div>
    <div class="text-center mt-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary px-4">
            ← Back to Home
        </a>
    </div>
</div>