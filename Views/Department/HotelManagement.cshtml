@{
    ViewData["Title"] = "Hotel Management Department";
}

<div class="container my-4">

    <div class="card border-0 shadow-lg rounded-4 overflow-hidden">

        <div class="p-4 text-center text-white"
             style="background:linear-gradient(135deg,#e83e8c,#ff6b9d);">

            <h1 class="fw-bold">🏨 Hotel Management Department</h1>

            <p class="mb-0">
                B.Sc. Hospitality Studies
            </p>

        </div>

        <div class="card-body p-4">

            <h3 class="fw-bold mb-3" style="color:#e83e8c;">
                About the Program
            </h3>

            <p>
                The Bachelor of Science (B.Sc.) in Hospitality Studies is a
                comprehensive three-year undergraduate program divided into
                six semesters, including a six-month industrial training
                component.
            </p>

            <p>
                The program provides knowledge and practical skills related to
                Front Office, Food & Beverage Service, Kitchen, Housekeeping,
                Human Resources, Accounting, Food Science, Organizational
                Behaviour, Principles of Management, Communication Skills
                and Computer Skills.
            </p>


            <h3 class="fw-bold mt-4" style="color:#e83e8c;">
                Key Features
            </h3>

            <ul>
                <li>Comprehensive understanding of the hospitality industry.</li>
                <li>Practical knowledge of hotel operations.</li>
                <li>Training in food and beverage management.</li>
                <li>Housekeeping and front-office management.</li>
                <li>Development of customer service and communication skills.</li>
                <li>Leadership and problem-solving skills.</li>
                <li>Hands-on training and internships.</li>
                <li>Exposure to real-world hospitality environments.</li>
            </ul>


            <h3 class="fw-bold mt-4" style="color:#e83e8c;">
                Program Details
            </h3>

            <ul>
                <li><strong>Degree:</strong> B.Sc. (Hons)</li>
                <li><strong>Duration:</strong> 3 Years</li>
                <li><strong>University:</strong> University of Mumbai</li>
                <li><strong>Eligibility:</strong> HSC Pass or Equivalent</li>
            </ul>


            <h3 class="fw-bold mt-4" style="color:#e83e8c;">
                Diploma Program
            </h3>

            <ul>
                <li><strong>Duration:</strong> 2 Years</li>
                <li><strong>Equivalent to:</strong> HSC</li>
                <li>
                    <strong>Board:</strong>
                    Maharashtra State Board of Skill and Vocational Education
                </li>
                <li><strong>Eligibility:</strong> SSC Pass</li>
            </ul>


            <h3 class="fw-bold mt-4" style="color:#e83e8c;">
                Career Opportunities
            </h3>

            <p>
                The program prepares students for careers in:
            </p>

            <ul>
                <li>Hotel Management</li>
                <li>Restaurant Management</li>
                <li>Event Planning</li>
                <li>Tourism</li>
                <li>Hospitality Industry</li>
            </ul>


            <h3 class="fw-bold mt-4" style="color:#e83e8c;">
                Practical Exposure
            </h3>

            <ul>
                <li>Students gain theoretical and practical hospitality skills.</li>
                <li>Students get opportunities to work in real-world environments.</li>
                <li>
                    Regular visits to hotels, restaurants and
                    event-management companies are conducted.
                </li>
                <li>Students learn about international hospitality standards.</li>
                <li>Practical exposure improves employability.</li>
            </ul>

        </div>

    </div>
    <div class="text-center mt-4">
        <a asp-controller="Home"
           asp-action="Index"
           class="btn btn-secondary px-4">
            ← Back to Home
        </a>
    </div>
</div>